# Cloudflare Pages headers. Copied verbatim into dist/ at build time.
# https://developers.cloudflare.com/pages/configuration/headers/

# Astro emits every JS, CSS, and font asset here with a content hash in the
# filename, so a new build always means a new URL. Safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML is not hashed and is revalidated on every request so deploys go live
# immediately. Cloudflare's CDN still serves the cached copy while it revalidates.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
