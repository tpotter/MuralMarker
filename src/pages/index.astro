---
import Base from "../layouts/Base.astro";
import Title from "../components/Title.astro";
import { Map } from "../components/Map";
import { getCollection } from "astro:content";

const entries = await getCollection("murals"); // Array<{ id, data }>
const murals = entries.map((e) => ({ id: e.id, ...e.data }));
---

<Base title="Mural Marker">
  <Title />
  <Map client:only murals={murals} />
</Base>
