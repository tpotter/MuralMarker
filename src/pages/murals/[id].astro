---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import type { InferGetStaticPropsType } from "astro";
import PageLayout from "../../layouts/PageLayout.astro";
import VisibilityPill from "../../components/VisibilityPill.astro";
import { getPhotoImgProps } from "../../lib/photos";

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const PHOTO_SIZES = "(max-width: 1040px) calc(100vw - 2rem), 1000px";

export async function getStaticPaths() {
  const murals = await getCollection("murals");
  return murals.map((entry) => ({
    params: { id: entry.id },
    props: { mural: entry.data },
  }));
}
const { mural } = Astro.props;
const { id } = Astro.params;

// Used for locking the photo index to zero, will be dynamic when multiple photos are supported
const PHOTO_INDEX = 0;

const photoProps = getPhotoImgProps(id, mural.photos[PHOTO_INDEX], PHOTO_SIZES);

let alt = "";
if (mural.photos[PHOTO_INDEX]) {
  alt = mural.photos[PHOTO_INDEX].caption ?? mural.title ?? "Untitled";
} else {
  alt = "No photo available";
}
---

<Base title={mural.title ?? "Mural Marker"}>
  <PageLayout>
    <div class="flex flex-col p-3">
      <div class="flex gap-2 items-center lg:hidden">
        <h1 class="text-3xl lg:text-5xl">{mural.title || "Untitled"}</h1>
        <div>
          <VisibilityPill visibility={mural.status} />
        </div>
      </div>
      <p class="lg:hidden text-xs lg:text-sm">
        {`Entry Last Updated: ${mural.lastUpdated}`}
      </p>
      <div class="flex flex-col-reverse lg:flex-row gap-2 lg:text-xl mt-2">
        <div class="lg:w-1/3">
          <div class="hidden lg:flex gap-2 items-center">
            <h1 class="text-3xl lg:text-5xl">{mural.title || "Untitled"}</h1>
            <div>
              <VisibilityPill visibility={mural.status} />
            </div>
          </div>
          <p class="hidden lg:block text-xs lg:text-sm">
            {`Entry Last Updated: ${mural.lastUpdated}`}
          </p>

          <dl class="lg:border-t">
            <dt class="font-bold">
              {mural.artists.length > 1 ? "Artists:" : "Artist:"}
            </dt>
            <dd>
              <div class="flex flex-col gap-1">
                {
                  mural.artists.map((artist) => {
                    return (
                      <div class="flex gap-2">
                        <span>{artist.name}</span>
                        {artist.url ? (
                          <span>
                            &lt;
                            <a class="break-all" href={artist.url}>
                              {artist.url}
                            </a>
                            &gt;
                          </span>
                        ) : (
                          <span class="italic">No artist page available</span>
                        )}
                      </div>
                    );
                  })
                }
              </div>
            </dd>
            <dt class="font-bold">Dates:</dt>
            <dd>
              <div class="flex gap-1">
                <span>
                  {mural.dateStart.month}
                  {mural.dateStart.month && <span>&#47;</span>}
                  {mural.dateStart.year}
                </span>
                -{/* Mural still present */}
                {
                  !mural.dateEnd && !mural.removalDateUncertain && (
                    <span>Present Day</span>
                  )
                }
                {/* Defined removal date */}
                {
                  mural.dateEnd && !mural.removalDateUncertain && (
                    <span>
                      {mural.dateEnd.month}
                      {mural.dateEnd.month && <span>&#47;</span>}
                      {mural.dateEnd.year}
                    </span>
                  )
                }
                {/* Removed, but unknown when */}
                {
                  mural.dateEnd && mural.removalDateUncertain && (
                    <span>Unknown</span>
                  )
                }
              </div>
            </dd>
            <dt class="font-bold">Location:</dt>
            <dd class="flex flex-col">
              <div>
                {mural.location.neighborhood}
                {
                  mural.location.neighborhood && mural.location.address && (
                    <span>-</span>
                  )
                }
                {mural.location.address}
              </div>
              <div>
                <a
                  href={`https://www.openstreetmap.org/?mlat=${mural.location.lat}&mlon=${mural.location.lng}#map=18/${mural.location.lat}/${mural.location.lng}`}
                  >{mural.location.lat}, {mural.location.lng}</a
                >
              </div>
            </dd>
            {
              mural.description && (
                <>
                  <dt class="font-bold">Notes:</dt>
                  <dd>{mural.description}</dd>
                </>
              )
            }
          </dl>
        </div>
        <div class="flex flex-col lg:w-2/3">
          <img
            class="md:w-4/5 lg:w-4/5 ml-auto mr-auto bg-neutral-200 bg-[url('/photo-loading.svg')] bg-center bg-no-repeat bg-[length:96px]"
            alt={alt}
            loading={"eager"}
            decoding="async"
            {...photoProps}
          />
          {
            mural.photos[PHOTO_INDEX] && (
              <p class="text-sm md:w-4/5 lg:w-4/5 md:ml-auto md:mr-auto">
                Photo credit:{" "}
                {mural.photos[PHOTO_INDEX].credit ?? "Unknown photographer"}
              </p>
            )
          }
        </div>
      </div>
    </div>
  </PageLayout>
</Base>
