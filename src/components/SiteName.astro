---
import "@fontsource/alata";
import Logo from "../assets/logo.svg";

interface Props {
  showSiteName?: boolean;
}

const { showSiteName } = Astro.props;

const logoClass = showSiteName
  ? "w-6 md:w-14 text-neutral-700"
  : "w-12 md:w-16 text-neutral-700";
---

<div class="flex gap-1 md:gap-2 select-none">
  <Logo aria-hidden="true" class={logoClass} stroke-width="2px" />

  {
    showSiteName && (
      <h1 class="text-3xl sm:text-4xl md:text-6xl">Mural Marker</h1>
    )
  }
</div>
